# Standalone-export settings only. For the active Replit monorepo, use the root
# .env.example and docs/operations/REPLIT_SETUP.md. Weather needs no API keys;
# hosted routing and private storage require configuration.
HOST=127.0.0.1
PORT=5173
# Local reference/cache directory. Published Replit filesystems are not durable.
ATLAS_DATA_DIR=./data
# Optional maintained OSRM service, e.g. http://127.0.0.1:5000/
# No public demonstration server is used for production routing.
# ATLAS_ROUTING_URL=
# Optional Python runtime with OR-Tools installed (defaults to .venv/bin/python).
# ATLAS_PYTHON=
