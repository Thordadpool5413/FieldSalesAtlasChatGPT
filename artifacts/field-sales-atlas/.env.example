# Copy to .env for optional local overrides. No API keys are required.
HOST=127.0.0.1
PORT=5173
# Keep this directory on a persistent volume when deploying.
ATLAS_DATA_DIR=./data
# Optional maintained OSRM service, e.g. http://127.0.0.1:5000/
# No public demonstration server is used for production routing.
# ATLAS_ROUTING_URL=
# Optional Python runtime with OR-Tools installed (defaults to .venv/bin/python).
# ATLAS_PYTHON=
