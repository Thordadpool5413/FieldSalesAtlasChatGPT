{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "build": "pnpm run typecheck && pnpm -r --filter @workspace/api-server --filter @workspace/field-sales-atlas run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev": "pnpm --filter @workspace/api-server run build && node scripts/start-local.mjs",
    "replit": "bash scripts/start-replit.sh",
    "setup:optimizer": "bash scripts/setup-optimizer.sh",
    "start:preview": "node scripts/start-local.mjs --preview",
    "test": "pnpm --filter @workspace/field-sales-atlas test",
    "test:api": "pnpm --filter @workspace/api-server smoke",
    "test:e2e": "pnpm --filter @workspace/field-sales-atlas test:e2e",
    "data:airports": "pnpm --filter @workspace/field-sales-atlas run data:airports",
    "data:check-sources": "pnpm --filter @workspace/field-sales-atlas run data:check-sources",
    "data:import-bts": "pnpm --filter @workspace/field-sales-atlas run data:import-bts",
    "data:sync-bts": "pnpm --filter @workspace/field-sales-atlas run data:sync-bts",
    "setup:routing": "pnpm --filter @workspace/field-sales-atlas run setup:routing",
    "test:runtime": "node --test scripts/local-runtime.test.mjs",
    "data:backup": "node scripts/backup-data.mjs",
    "data:verify-backup": "node scripts/verify-backup.mjs",
    "data:maintain": "pnpm --filter @workspace/field-sales-atlas run data:maintain"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.10.0 <25"
  }
}
