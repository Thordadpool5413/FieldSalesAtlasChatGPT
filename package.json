{
  "name": "field-sales-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --use-env-proxy server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "node --use-env-proxy --import tsx server/index.ts --production",
    "preview": "npm start",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "node --use-env-proxy --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "papaparse": "^5.5.3",
    "maplibre-gl": "^6.16.0",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.20.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=24.10.0 <25"
  }
}
