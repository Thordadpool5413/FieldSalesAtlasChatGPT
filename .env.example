# These are server settings. In Replit, use Secrets/settings, not a committed .env.
# Replit supplies DATABASE_URL automatically for its managed database; never paste
# the value into chat or copy the development URL over the production setting.
ATLAS_DATABASE_ENGINE=sqlite
# Complete data:migrate-records and its --apply verification BEFORE changing to postgres.
# DATABASE_URL=postgresql://...
PORT=24397
ATLAS_API_PORT=8080
ATLAS_DATA_DIR=artifacts/field-sales-atlas/data

# Hosted road routing (a free account/key and quota review are required).
# ATLAS_ROUTING_PROVIDER=openrouteservice
# ATLAS_ORS_API_KEY=
# Alternative: a maintained OSRM endpoint. No public demo routing server is used.
# ATLAS_ROUTING_URL=

# Private Replit App Storage; SDK authenticates inside Replit automatically.
# ATLAS_BACKUP_BUCKET_ID=
# ATLAS_BACKUP_SCOPE=development
# Use production scope separately for the published database.

# Optional external maintenance trigger; at least 32 random characters.
# ATLAS_MAINTENANCE_TOKEN=
# ATLAS_BTS_AUTO_SYNC=1

# Optional authorized flight-specific provider (account usage may be billed).
ATLAS_AEROAPI_KEY=
# Comma-separated workspace IDs approved by the deployment owner; no public guest access.
ATLAS_AEROAPI_WORKSPACE_IDS=
# Add only after reviewing provider costs/limits; each trip must also opt in.
ATLAS_FLIGHT_STATUS_POLLING=

# Optional reviewed primary-calendar connections. See docs/operations/CONNECTED_TRIP_SETUP.md.
ATLAS_PUBLIC_URL=https://field-sales-atlas.replit.app
# Exactly 64 random hexadecimal characters, retained securely outside Git.
ATLAS_CONNECTION_ENCRYPTION_KEY=
ATLAS_GOOGLE_CLIENT_ID=
ATLAS_GOOGLE_CLIENT_SECRET=
ATLAS_MICROSOFT_CLIENT_ID=
ATLAS_MICROSOFT_CLIENT_SECRET=
# Optional valid mailto: contact or HTTPS application URL for Web Push VAPID.
ATLAS_PUSH_SUBJECT=https://field-sales-atlas.replit.app
